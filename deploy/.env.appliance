# ============================================================
# AI-OS Appliance — hybrid backend config (local Ollama + cloud)
# Copy to the repo root as ".env" on the VM.
# ============================================================

# --- App ---
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
AUTH_ENABLED=false

# --- Local model backend (always-on, offline-capable) ---
OLLAMA_BASE_URL=http://localhost:11434
# Default local model used when no model is specified and as the final fallback.
DEFAULT_LOCAL_MODEL=llama3.2

# --- Cloud fallback (OPTIONAL) ---
# Leave blank to run local-only. Fill any of these to enable hybrid routing:
# the gateway prefers what you request, then falls back through available
# providers, ending at local Ollama.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=

# --- Infra (provided by docker-compose, or point at local installs) ---
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Voice layer (Phase 2) ---
# Speech-to-text (faster-whisper): tiny|base|small|medium|large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
# Text-to-speech (Piper): where voice models live + which one to use.
PIPER_VOICES_DIR=/opt/aios/voices
# PIPER_VOICE_MODEL=/opt/aios/voices/en_US-amy-medium.onnx   # auto-detected if unset

# --- Wake word (Phase 2b): hands-free "always listening" daemon ---
# Built-in choices: hey_jarvis, alexa, hey_mycroft. A custom "Hey <Name>" needs
# a trained openWakeWord model.
WAKE_WORD=hey_jarvis
WAKE_THRESHOLD=0.5
AIOS_API=http://localhost:8080

# --- Dashboard ---
# Absolute path to dashboard.html (auto-detected if left unset).
# DASHBOARD_HTML=/opt/aios/app/frontend/dashboard.html
