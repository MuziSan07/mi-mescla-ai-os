# Copy this file to .env and fill in your values
# cp .env.example .env

# -------------------------------------------------------
# SECURITY — REQUIRED before running
# -------------------------------------------------------
# Generate a secure 32-byte key:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# The application will REFUSE TO START if this is left empty or is a placeholder.
SECRET_KEY=

# JWT signing secret (can be the same as SECRET_KEY or a separate key)
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# JWT settings
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE=3600
JWT_REFRESH_EXPIRE=604800

# -------------------------------------------------------
# AUTH & CORS
# -------------------------------------------------------
# Auth is ENABLED by default. Set to false ONLY in local dev.
AUTH_ENABLED=true

# Restrict CORS to your actual frontend domain(s) in production.
# Use comma-separated values. Never use * in production.
# Example: ALLOWED_ORIGINS=https://myapp.com,https://admin.myapp.com
ALLOWED_ORIGINS=http://localhost:3000

# -------------------------------------------------------
# SERVICES
# -------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# -------------------------------------------------------
# OPTIONAL INTEGRATIONS
# -------------------------------------------------------
# Stable Diffusion (Automatic1111 with --api flag)
SD_BASE_URL=http://localhost:7860

# Google Colab (for GPU workers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# GitHub & HuggingFace
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=

# Qdrant vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Workers
MAX_WORKERS=10
WORKER_TIMEOUT=300
MAX_COLAB_VMS=5

# Tenants DB
TENANT_DB_PATH=/app/src/ai_os/data/tenants.db

# Audit
AUDIT_INTERVAL=300
AUTO_CORRECT=true

# External services
N8N_BASE_URL=http://cline-ai-n8n:5678
COMFYUI_BASE_URL=http://localhost:8188
AIOS_BASE_URL=http://cline-ai-app:8080

# -------------------------------------------------------
# DEBUG (false in production)
# -------------------------------------------------------
DEBUG=false
