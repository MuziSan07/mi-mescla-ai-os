# Copy this file to .env and fill in your values
# cp .env.example .env

# -------------------------------------------------------
# SECURITY — change these before deploying!
# -------------------------------------------------------
# Generate a secure key: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# Restrict CORS to your frontend domain(s) in production
# Use * for dev only
ALLOWED_ORIGINS=*
# Production example:
# ALLOWED_ORIGINS=https://myapp.com,https://api.myapp.com

# Enable JWT auth enforcement (false = dev mode, anyone can call API)
AUTH_ENABLED=false

# -------------------------------------------------------
# SERVICES
# -------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text

REDIS_HOST=redis
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# -------------------------------------------------------
# OPTIONAL INTEGRATIONS
# -------------------------------------------------------
# Stable Diffusion (Automatic1111 with --api flag)
SD_BASE_URL=http://localhost:7860

# Google Colab (for GPU workers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# GitHub & HuggingFace
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=

# Qdrant vector DB (optional, future use)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Workers
MAX_WORKERS=10
WORKER_TIMEOUT=300
MAX_COLAB_VMS=5

# Tenants DB
TENANT_DB_PATH=/app/src/ai_os/data/tenants.db

# Audit
AUDIT_INTERVAL=300
AUTO_CORRECT=true

N8N_BASE_URL=http://cline-ai-n8n:5678
COMFYUI_BASE_URL=http://localhost:8188
AIOS_BASE_URL=http://cline-ai-app:8080