# Copy to .env:  cp .env.example .env
# Then fill in SECRET_KEY and JWT_SECRET with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# The app will REFUSE TO START if SECRET_KEY is missing or a placeholder.

SECRET_KEY=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE=3600
JWT_REFRESH_EXPIRE=604800

AUTH_ENABLED=true
ALLOWED_ORIGINS=http://localhost:3000

OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

SD_BASE_URL=http://localhost:7860
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=
QDRANT_HOST=localhost
QDRANT_PORT=6333

MAX_WORKERS=10
WORKER_TIMEOUT=300
MAX_COLAB_VMS=5
TENANT_DB_PATH=/app/src/ai_os/data/tenants.db
AUDIT_INTERVAL=300
AUTO_CORRECT=true
N8N_BASE_URL=http://cline-ai-n8n:5678
COMFYUI_BASE_URL=http://localhost:8188
AIOS_BASE_URL=http://cline-ai-app:8080
DEBUG=false
